library project Websocket_Ada is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "websocket_ada";
   for Library_Kind use "dynamic";
   for Create_Missing_Dirs use "True";
   
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnatwe", "-gnatyM120");
   end Compiler;
end Websocket_Ada;
